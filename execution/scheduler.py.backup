from dataclasses import dataclass, field
from enum import Enum
from typing import Any

from execution.workers import (
    Worker,
    WorkerRegistry,
    WorkerResult,
    WorkerTask,
)


class SchedulingStrategy(str, Enum):
    """
    Aurora-inspired worker selection strategies.
    """

    ROUND_ROBIN = "round_robin"

    LEAST_BUSY = "least_busy"

    PRIORITY = "priority"


@dataclass
class DispatchRecord:
    """
    Record of a task dispatched by Cauvis.

    This provides the foundation for task history,
    metrics, and adaptive scheduling later.
    """

    task_id: str

    task_name: str

    worker_name: str | None

    strategy: SchedulingStrategy

    success: bool

    error: str | None = None

    execution_time: float = 0.0

    metadata: dict[str, Any] = field(
        default_factory=dict
    )


@dataclass
class SchedulerResult:
    """
    Standard result returned by the scheduler.
    """

    success: bool

    task_id: str

    worker_name: str | None = None

    worker_result: WorkerResult | None = None

    error: str | None = None

    metadata: dict[str, Any] = field(
        default_factory=dict
    )


class WorkerScheduler:
    """
    Aurora-inspired task dispatcher for Cauvis.

    Responsibilities:

    1. Find workers capable of handling a task.
    2. Select the best worker using a scheduling strategy.
    3. Dispatch the task.
    4. Record the result.

    The scheduler does NOT:

    - grant permissions
    - execute arbitrary system commands
    - bypass the Tool Registry
    - replace the Execution Engine
    - replace verification

    Those responsibilities remain in Cauvis's
    existing architecture.
    """

    def __init__(
        self,
        registry: WorkerRegistry,
        strategy: SchedulingStrategy = (
            SchedulingStrategy.LEAST_BUSY
        ),
    ):
        self.registry = registry

        self.strategy = strategy

        self._round_robin_index = 0

        self._history: list[
            DispatchRecord
        ] = []

    def set_strategy(
        self,
        strategy: SchedulingStrategy,
    ) -> None:
        """
        Change the scheduling strategy.
        """

        self.strategy = strategy

    def get_strategy(
        self,
    ) -> SchedulingStrategy:
        return self.strategy

    def find_candidates(
        self,
        task: WorkerTask,
    ) -> list[Worker]:
        """
        Find all enabled workers capable of
        handling the task.
        """

        return self.registry.find_for_task(
            task
        )

    def select_worker(
        self,
        task: WorkerTask,
    ) -> Worker | None:
        """
        Select the best available worker.
        """

        candidates = self.find_candidates(
            task
        )

        if not candidates:
            return None

        if (
            self.strategy
            == SchedulingStrategy.ROUND_ROBIN
        ):
            worker = candidates[
                self._round_robin_index
                % len(candidates)
            ]

            self._round_robin_index += 1

            return worker

        if (
            self.strategy
            == SchedulingStrategy.PRIORITY
        ):
            return min(
                candidates,
                key=lambda worker: (
                    -task.priority,
                    worker.metrics.tasks_started,
                    worker.metrics.tasks_failed,
                    worker.name,
                ),
            )

        return min(
            candidates,
            key=lambda worker: (
                worker.metrics.tasks_started,
                worker.metrics.tasks_failed,
                worker.metrics.total_execution_time,
                worker.name,
            ),
        )

    def dispatch(
        self,
        task: WorkerTask,
    ) -> SchedulerResult:
        """
        Select a worker and dispatch the task.
        """

        worker = self.select_worker(
            task
        )

        if worker is None:

            result = SchedulerResult(
                success=False,
                task_id=task.task_id,
                error=(
                    "No enabled worker can "
                    "handle the task."
                ),
                metadata={
                    "strategy": (
                        self.strategy.value
                    ),
                    "required_capabilities": sorted(
                        task.required_capabilities
                    ),
                },
            )

            self._record(
                task=task,
                worker=None,
                result=result,
            )

            return result

        worker_result = worker.execute(
            task
        )

        result = SchedulerResult(
            success=worker_result.success,
            task_id=task.task_id,
            worker_name=worker.name,
            worker_result=worker_result,
            error=worker_result.error,
            metadata={
                "strategy": (
                    self.strategy.value
                ),
                "candidate_count": len(
                    self.find_candidates(task)
                ),
            },
        )

        self._record(
            task=task,
            worker=worker,
            result=result,
        )

        return result

    def _record(
        self,
        task: WorkerTask,
        worker: Worker | None,
        result: SchedulerResult,
    ) -> None:

        execution_time = 0.0

        if result.worker_result is not None:
            execution_time = (
                result.worker_result.execution_time
            )

        self._history.append(
            DispatchRecord(
                task_id=task.task_id,
                task_name=task.name,
                worker_name=(
                    worker.name
                    if worker is not None
                    else None
                ),
                strategy=self.strategy,
                success=result.success,
                error=result.error,
                execution_time=execution_time,
                metadata={
                    "priority": task.priority,
                    "task_type": (
                        task.task_type.value
                    ),
                    "required_capabilities": sorted(
                        task.required_capabilities
                    ),
                },
            )
        )

    def history(
        self,
    ) -> list[DispatchRecord]:
        """
        Return a copy of dispatch history.
        """

        return list(self._history)

    def clear_history(self) -> None:
        self._history.clear()

    def history_count(self) -> int:
        return len(self._history)

    def worker_load(
        self,
    ) -> dict[str, int]:
        """
        Return the number of started tasks per worker.
        """

        return {
            worker.name: worker.metrics.tasks_started
            for worker
            in self.registry.list_all()
        }

    def worker_success_rates(
        self,
    ) -> dict[str, float]:
        """
        Return success rates for workers that have
        processed at least one task.
        """

        rates: dict[str, float] = {}

        for worker in self.registry.list_all():

            total = (
                worker.metrics.tasks_completed
                + worker.metrics.tasks_failed
            )

            if total == 0:
                continue

            rates[worker.name] = (
                worker.metrics.tasks_completed
                / total
            )

        return rates